SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Spotify API does not allow localhost redirect URIs
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback

# Postgres connection string
# The format is:
#   postgres://<user>:<password>@<host>:<port>/<database name>
# Hosted databases usually need `?sslmode=require` on the end.
DATABASE_URL=

# Connection string for a separate database used only by the tests.
# Put this in `.env.test`.
TEST_DATABASE_URL=

# Comma-separated Spotify user IDs allowed to use the settings page
# Example with two admins (replace with your own IDs):
#   SPOTIFY_ADMIN_USER_IDS=user_id_1,user_id_2
SPOTIFY_ADMIN_USER_IDS=
